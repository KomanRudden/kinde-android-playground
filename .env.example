# ---------------------------------------------------------------------------
# Kinde application (Settings > Applications > Add application > Android)
# Register these on the application's Details page:
#   Allowed callback URLs:        com.kinde.playground://kinde_callback
#   Allowed logout redirect URLs: com.kinde.playground://kinde_logout
# (replace com.kinde.playground if you change KINDE_REDIRECT_SCHEME)
# ---------------------------------------------------------------------------
KINDE_DOMAIN=your-business.kinde.com
KINDE_CLIENT_ID=
# Optional: request an access token for one of your APIs
KINDE_AUDIENCE=
# The URI scheme AppAuth listens on (manifest placeholder appAuthRedirectScheme)
KINDE_REDIRECT_SCHEME=com.kinde.playground

# ---------------------------------------------------------------------------
# Playground behaviour (compiled into the APK; rebuild after changing)
# ---------------------------------------------------------------------------
# programmatic: KindeClient.getInstance(context, KindeConfig(...)) in Application.onCreate
# manifest:     AndroidManifest meta-data (au.kinde.domain / au.kinde.clientId / au.kinde.audience)
PLAYGROUND_CONFIG_MODE=programmatic
PLAYGROUND_SCOPES=openid offline email profile
# Shows "Reveal" on the Tokens page. Never in a build you share.
PLAYGROUND_DEBUG=false
# Enables createUser() on the Management page. Use a test business.
PLAYGROUND_ALLOW_MUTATIONS=false

# Keys the demo checks use. Create them in Kinde to see them granted.
PLAYGROUND_DEMO_PERMISSION=read:reports
PLAYGROUND_DEMO_ROLE=admin
PLAYGROUND_DEMO_FLAG=beta_dashboard
PLAYGROUND_DEMO_STRING_FLAG=theme
PLAYGROUND_DEMO_INT_FLAG=max_items
PLAYGROUND_DEMO_ENTITLEMENT=pro_reports
# Optional: an org to switch to, a connection ID (e.g. a social login), a pricing table
PLAYGROUND_DEMO_ORG_CODE=
PLAYGROUND_CONNECTION_ID=
PLAYGROUND_PRICING_TABLE=

# ---------------------------------------------------------------------------
# Host-only: Management API (Machine to machine app authorized for the Kinde
# Management API). Read by the host live tests (./scripts/regression.sh --live)
# and NEVER compiled into the APK. Useful scopes: read:application_redirect_uris,
# read:application_logout_uris, read:permissions, read:roles,
# read:environment_feature_flags, read:users.
# ---------------------------------------------------------------------------
KINDE_MANAGEMENT_CLIENT_ID=
KINDE_MANAGEMENT_CLIENT_SECRET=
# Required with a custom domain: the Management API audience must be your
# Kinde subdomain (https://your-business.kinde.com/api). Defaults to KINDE_DOMAIN.
KINDE_MANAGEMENT_DOMAIN=
